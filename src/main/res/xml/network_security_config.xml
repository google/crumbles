<!-- TLS is validated against the system CAs only, and cleartext is never permitted: any app can
     listen on a loopback port and impersonate a WebDAV server on this device. Debug builds replace
     this file with src/debug/res/xml/network_security_config.xml, which permits it for testing. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
